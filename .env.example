# Kopier denne filen til .env og fyll inn verdiene fra
# Supabase-dashboardet → Project Settings → API Keys / Data API.
#
# Begge verdiene er ment å være offentlige (de havner i nettleseren).
# Tilgangen styres av Row Level Security i supabase/schema.sql.
# Legg ALDRI inn secret- eller service_role-nøkkelen her.

VITE_SUPABASE_URL=https://<prosjekt-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
